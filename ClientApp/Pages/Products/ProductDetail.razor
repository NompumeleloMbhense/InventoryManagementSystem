@page "/products/{ProductId:int}" 
@using SharedApp.Dto
@using ClientApp.Services
@inject ProductService ProductService
@inject NavigationManager Navigation

<h3 class="text-2xl font-bold mb-4">Product Details</h3>

@if (product is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card p-4 shadow-sm border-0">
        <h4 class="fw-bold">@product.Name</h4>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <p><strong>Price:</strong> R @product.Price.ToString("N2")</p>
                <p><strong>Current Stock:</strong> @product.Stock units</p>
                <p><strong>Category:</strong> @product.Category</p>
            </div>
            <div class="col-md-6 border-start">
                <p><strong>Supplier:</strong> @product.SupplierName</p>
                <p><strong>Location:</strong> @product.SupplierLocation</p>
            </div>
        </div>

        <button class="btn btn-secondary mt-3 align-self-start" 
            @onclick='() => Navigation.NavigateTo("/products")'><i class="bi bi-arrow-left"></i> 
            Back to Products
        </button>
    </div>

     @* --- STOCK HISTORY SECTION --- *@
    <h4 class="fw-bold mb-3 mt-4">Stock Movement History</h4>
    
    @if (history == null)
    {
        <p><em>Loading history...</em></p>
    }
    else if (!history.Any())
    {
        <div class="alert alert-info">No movement history recorded for this product yet.</div>
    }
    else
    {
        <div class="table-responsive bg-white shadow-sm rounded">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Action</th>
                        <th class="text-center">Change</th>
                        <th>Performed By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in history)
                    {
                        <tr>
                            <td>@log.DateOccurred.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@log.ActionType</td>
                            <td class="text-center fw-bold">
                                @if (log.QuantityChange > 0)
                                {
                                    <span class="text-success">+@log.QuantityChange</span>
                                }
                                else
                                {
                                    <span class="text-danger">@log.QuantityChange</span>
                                }
                            </td>
                            <td>@log.PerformedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter] public int ProductId { get; set; } 
    private ProductReadDto? product; 

    private IEnumerable<StockTransactionReadDto>? history;

    protected override async Task OnInitializedAsync()
    {
        // Fetch both the product details and the history
        var productTask = ProductService.GetByIdAsync(ProductId);
        var historyTask = ProductService.GetHistoryAsync(ProductId);

        // Run them together to speed up the page load
        await Task.WhenAll(productTask, historyTask);

        product = await productTask;
        history = await historyTask;
    }
}