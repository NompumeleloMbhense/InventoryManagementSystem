@page "/products"
@attribute [Authorize]
@using SharedApp.Dto
@using ClientApp.Services
@inject NavigationManager Navigation
@inject ProductService ProductService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">Products</h3>
    @if (isAdmin)
    {
        <button class="btn btn-success" @onclick='() => Navigation.NavigateTo("/products/add")'>
            Add Product
        </button>

        <button class="btn btn-outline-dark" @onclick="ExportToCsv" disabled="@isExporting">
            @if (isExporting)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>Generating...</span>
            }
            else
            {
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>
                <span>Export All CSV</span>
            }
        </button>
    }
</div>

<!-- Search & Filter Section -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-5">
                <input type="text" class="form-control" placeholder="Search by product name..." @bind="searchQuery" />
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="selectedCategory">
                    <option value="">All Categories</option>
                    <option value="Tech & Electronics">Tech & Electronics</option>
                    <option value="Home & Lifestyle">Home & Lifestyle</option>
                    <option value="Office & Accessories">Office & Accessories</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button class="btn btn-primary w-100" @onclick="PerformSearch">Search</button>
                <button class="btn btn-outline-secondary w-100" @onclick="ClearSearch">Clear</button>
            </div>
        </div>
    </div>
</div>

@if (products is null)
{
    <p><em>Loading inventory...</em></p>
}
else
{
    <div class="table-responsive bg-white shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Category</th>
                    @if (isAdmin)
                    {
                        <th class="text-center">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var p in products.Data)
                {
                    <tr>
                        <td>
                            <a href="/products/@p.ProductId" class="text-decoration-none fw-bold">@p.Name</a>
                        </td>
                        <td>R @p.Price.ToString("N2")</td>
                        <td>
                            <span class="badge @(p.Stock <= 5 ? "bg-danger" : "bg-success")">
                                @p.Stock units
                            </span>
                        </td>
                        <td>@p.Category</td>
                        @if (isAdmin)
                        {
                            <td class="text-center">
                                @* --- ORANGE EDIT BUTTON --- *@
                                <button class="btn btn-sm fw-bold me-2"
                                        style="background-color: #ff8c00; color: white; border: none;"
                                        @onclick='() => Navigation.NavigateTo($"/products/edit/{p.ProductId}?returnPage={pageNumber}")'>
                                    Edit
                                </button>
                                @* --- RED DELETE BUTTON --- *@
                                <button class="btn btn-sm btn-danger fw-bold" @onclick="() => DeleteProduct(p.ProductId, p.Name)">
                                    Delete
                                </button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (string.IsNullOrWhiteSpace(searchQuery) && string.IsNullOrWhiteSpace(selectedCategory))
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <button class="btn btn-outline-primary btn-sm" @onclick="PrevPage" disabled="@(pageNumber <= 1)">Previous</button>
            <span class="small text-muted">Page @pageNumber of @products.TotalPages</span>
            <button class="btn btn-outline-primary btn-sm" @onclick="NextPage"
                    disabled="@(pageNumber >= products.TotalPages)">Next</button>
        </div>
    }
}

@code
{
    private PagedResponse<ProductReadDto>? products;
    private bool isAdmin = false;
    private int pageNumber = 1;
    private string searchQuery = "";
    private string selectedCategory = "";

    private bool isExporting = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("Admin");

        await LoadProductsAsync();

        // Check for flags in the URL to show success messages
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("page", out var p) && int.TryParse(p, out var parsedPage))
        {
            pageNumber = parsedPage;
        }

        await LoadProductsAsync();

        // Check for flags (added/updated)
        if (query.ContainsKey("added"))
            await ShowAlert("Success!", "Product added.", "success");

        if (query.ContainsKey("updated"))
            await ShowAlert("Updated!", "Product saved.", "success");
    }

    private async Task ShowAlert(string title, string message, string icon)
    {
        await JSRuntime.InvokeVoidAsync("Swal.fire", title, message, icon);

        // Clean the URL (removes the ?added=true so it doesn't show again on refresh)
        Navigation.NavigateTo("/products", replace: true);
    }

    private async Task LoadProductsAsync()
    {
        products = await ProductService.GetPaginatedAsync(pageNumber, 8);
        
        // 2. KEEP THE URL UPDATED when we change pages
        // This ensures when we hit "Next", the URL becomes ?page=2
        var newUri = Navigation.GetUriWithQueryParameter("page", pageNumber);
        Navigation.NavigateTo(newUri, forceLoad: false);
    }
    private async Task PerformSearch()
    {
        var results = await ProductService.SearchAsync(searchQuery, selectedCategory);
        products = new PagedResponse<ProductReadDto> { Data = results, TotalPages = 1, PageNumber = 1 };
    }

    private async Task ClearSearch()
    {
        searchQuery = ""; selectedCategory = ""; pageNumber = 1;
        await LoadProductsAsync();
    }

    private async Task NextPage() { pageNumber++; await LoadProductsAsync(); }
    private async Task PrevPage() { pageNumber--; await LoadProductsAsync(); }

    private async Task DeleteProduct(int id, string name)
    {
        // Show confirmation dialog before deletion
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirmDelete", $"Remove '{name}' from inventory?");

        if (confirmed)
        {
            var success = await ProductService.DeleteAsync(id);
            if (success)
            {
                await LoadProductsAsync();

                //Show Success Alert immediately
                await JSRuntime.InvokeVoidAsync("Swal.fire", "Deleted!", "The product was removed.", "success");
            }
        }
    }

    private async Task ExportToCsv()
    {
        try
        {
            isExporting = true;

            // 1. Fetch the full list of products from the server
            var allProducts = await ProductService.GetAllForExportAsync();

            if (allProducts == null || !allProducts.Any())
            {
                await JSRuntime.InvokeVoidAsync("Swal.fire", "Info", "No data available to export.", "info");
                return;
            }

            // 2. Build the CSV string
            var csv = new System.Text.StringBuilder(); // Header row
            csv.AppendLine("Product ID,Name,Category,Price,Stock,Supplier,Supplier Location");

            foreach (var p in allProducts)
            {
                csv.AppendLine($"{p.ProductId},\"{p.Name}\",\"{p.Category}\",{p.Price},{p.Stock},\"{p.SupplierName}\",\"{p.SupplierLocation}\"");

            }

            // 3. Trigger the JS download helper to save the CSV file
            var fileName = $"Full_Inventory_{DateTime.Now:ddMMyyyy_HHmm}.csv";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, csv.ToString());
        }
        catch (Exception)
        {
            await JSRuntime.InvokeVoidAsync("Swal.fire", "Error", "Failed to export data.", "error");
        }
        finally
        {
            isExporting = false;
        }
    }
}