@page "/products/edit/{id:int}"
@using SharedApp.Dto
@using ClientApp.Services
@inject ProductService ProductService
@inject NavigationManager Navigation

<h3 class="mb-4">Edit Product</h3>

@if (editModel is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <ProductForm FormModel="editModel" SubmitButtonText="Update Changes" OnValidSubmitForm="HandleUpdate" />
}

@code
{
    [Parameter] public int id { get; set; }
    private ProductUpdateDto? editModel;

    private int returnPage = 1;

    protected override void OnInitialized()
    {
        // Capture the returnPage from the URL
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("returnPage", out var p))
        {
            int.TryParse(p, out returnPage);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var product = await ProductService.GetByIdAsync(id);
        if (product != null)
        {
            editModel = new ProductUpdateDto
            {
                Name = product.Name,
                Price = product.Price,
                Stock = product.Stock,
                Category = product.Category,
                SupplierId = product.SupplierId
            };
        }
    }

    private async Task HandleUpdate()
    {
        if (editModel != null)
        {
            var success = await ProductService.UpdateAsync(id, editModel);

            if (success)
            {
                // REDIRECT back to the specific page we came from
                Navigation.NavigateTo($"/products?page={returnPage}&updated=true");
            }
        }
    }
}