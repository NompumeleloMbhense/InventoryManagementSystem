@page "/suppliers/edit/{id:int}"
@using SharedApp.Dto
@using ClientApp.Services
@inject SupplierService SupplierService
@inject NavigationManager Navigation

<h3 class="mb-4">Edit Supplier</h3>

@if (editModel is null)
{
    <div class="spinner-border" role="status"></div>
}
else
{
    <SupplierForm FormModel="@editModel" SubmitButtonText="Update Changes" OnValidSubmitForm="HandleUpdate" />
}

@code
{
    [Parameter] public int id { get; set; }
    private SupplierUpdateDto? editModel;

    // Default to page 1
    private int returnPage = 1;

    // This runs first to capture the returnPage query parameter
    // before the async data load happens in OnInitializedAsync
    protected override void OnInitialized()
    {
        // Capture the returnPage from the URL
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("returnPage", out var p))
        {
            int.TryParse(p, out returnPage);
        }
    }


    protected override async Task OnInitializedAsync()
    {
        var supplier = await SupplierService.GetByIdAsync(id);
        if (supplier is not null)
        {
            editModel = new SupplierUpdateDto
            {
                Name = supplier.Name,
                Location = supplier.Location,
                Email = supplier.Email
            };
        }
    }

    private async Task HandleUpdate()
    {
        if (editModel != null)
        {
            var success = await SupplierService.UpdateAsync(id, editModel);

            if (success)
            {
                // REDIRECT back to the specific page and show the alert
                Navigation.NavigateTo($"/suppliers?page={returnPage}&updated=true");
            }
        }
    }
}